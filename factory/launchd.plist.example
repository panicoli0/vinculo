<?xml version="1.0" encoding="UTF-8"?>
<!--
  The trigger. Copy to ~/Library/LaunchAgents/ and load it:

    cp factory/launchd.plist.example \
       ~/Library/LaunchAgents/vinculo.factory.plist
    launchctl load ~/Library/LaunchAgents/vinculo.factory.plist

  To stop it:  launchctl unload ~/Library/LaunchAgents/vinculo.factory.plist

  StartInterval fires every 900 seconds while the machine is awake, and once on
  wake if a firing was missed. RunAtLoad is false on purpose: loading the job
  should not start an agent, only arm the schedule.

  Paths are absolute because launchd expands nothing. Replace USERNAME.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>vinculo.factory</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/USERNAME/development/vinculo/factory/agent-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/development/vinculo</string>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <false/>

  <!-- Both streams are also captured per pass in factory/runs/; this is the
       launchd-level catch-all for a failure that happens before logging starts. -->
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/development/vinculo/factory/runs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/development/vinculo/factory/runs/launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/USERNAME</string>
  </dict>

  <!-- Keep it off the critical path of whatever the human is doing. -->
  <key>Nice</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
