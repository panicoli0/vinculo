rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Matriz del §5 de data_model.md. Se agrega por fase; lo que no tiene su
    // `match` explícito queda cerrado por el `deny` del final.

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fase 2 (B2): cuentas de adultos. `bondPrefs` llega en la Fase 3.
    match /users/{uid} {
      allow get: if isSelf(uid);

      // Un adulto crea su propio documento; `consent`, `joinedVia` y
      // `firstAnsweredAt` quedan fuera de la lista cerrada de claves.
      allow create: if isSelf(uid)
        && request.resource.data.accountType == 'adult'
        && request.resource.data.birthYear is int
        && request.time.year() - request.resource.data.birthYear - 1 >= 18
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'accountType', 'displayName', 'birthYear',
          'uiLocale', 'cardLanguageMode', 'primaryLanguage', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40;

      // `birthYear`, `accountType`, `consent`, `joinedVia` y `firstAnsweredAt`
      // son inmutables desde el cliente.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'uiLocale', 'cardLanguageMode',
          'primaryLanguage', 'fakeDoorSeenAt'
        ])
        && (
          !('displayName' in
              request.resource.data.diff(resource.data).affectedKeys())
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 40
          )
        );

      // Solo la Function `deleteAccount` borra.
      allow delete: if false;

      match /devices/{installationId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
